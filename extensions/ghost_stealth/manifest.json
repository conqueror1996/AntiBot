{
  "manifest_version": 3,
  "name": "Ghost Sovereignty Core",
  "version": "2.0.0",
  "description": "High-fidelity browser-native stealth, fingerprint cloaking, and strike controllers.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
